+stop_fast_flashtalk() {
+  if [[ -f "$FAST_PID" ]]; then
+    local fast_pid
+    fast_pid="$(cat "$FAST_PID")"
+    if [[ "$fast_pid" =~ ^[0-9]+$ ]] && [[ -r "/proc/$fast_pid/cmdline" ]] &&
+       tr '\0' '\n' <"/proc/$fast_pid/cmdline" | grep -Fxq -- "$FAST_FLASHTALK_ROOT/ws_server.py"; then
+      kill "$fast_pid" && echo "stopped Fast-FlashTalk WS" || true
+    fi
+  fi
+}
+
 stop() {
+  stop_fast_flashtalk
   pkill -f "omnirt.cli.main serve-avatar-ws" 2>/dev/null && echo "stopped OmniRT avatar proxy" || true
   pkill -f "flashtalk_ws.py" 2>/dev/null && echo "stopped FlashTalk WS" || true
   pkill -f "flashhead_server.py" 2>/dev/null && echo "stopped FlashHead WS" || true
